# Required: your OpenAI API key
OPENAI_API_KEY=

# Model used for chat responses
OPENAI_MODEL=gpt-5-mini

# Reasoning effort: normal replies vs. when "Think" is toggled on
# (values depend on the model: minimal, low, medium, high)
REASONING_EFFORT_DEFAULT=low
REASONING_EFFORT_THINK=high

PORT=3001
DB_PATH=data/chatgpt.db
