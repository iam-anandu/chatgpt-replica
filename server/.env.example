# Required: your OpenAI secret key (starts with sk-)
OPENAI_API_KEY=

# Models shown in the model picker (comma-separated) and the default one
OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-5-nano
OPENAI_MODEL=gpt-5-mini

# Cheap model for background work: chat titles, memory extraction
UTILITY_MODEL=gpt-5-nano

# Reasoning effort: normal replies vs. when "Think" is toggled on
REASONING_EFFORT_DEFAULT=low
REASONING_EFFORT_THINK=high

# Other models
IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=low
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# Daily limits (0 = unlimited)
DAILY_TOKEN_LIMIT=0
DAILY_IMAGE_LIMIT=20
DAILY_VOICE_MINUTES=30
MAX_UPLOAD_MB=20
MAX_MEMORIES=200
MAX_HISTORY_MESSAGES=40

# Prices (USD) used only for the cost estimate on the Usage page
PRICE_INPUT_PER_1M=0.25
PRICE_OUTPUT_PER_1M=2
PRICE_PER_IMAGE=0.005
PRICE_PER_AUDIO_MINUTE=0.003

PORT=3001
DB_PATH=data/chatgpt.db
UPLOADS_DIR=data/uploads
